<!-- "Altyazıyı göster: TV / Bilgisayar ekranı / İkisi de" ve bilgisayar ekranındaki pencerenin seçenekleri (Mac: SubtitleOutputCard.swift).
     Ana ekranda ve ayarlarda aynı kart kullanılır. -->
<UserControl x:Class="CouchSubs.App.Views.SubtitleOutputCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:Card>
        <StackPanel>
            <TextBlock Text="{t:T 'Show subtitles on'}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch">
                <!-- "Bilgisayar ekranı" eşit üçte birde iki satıra bölünüyordu: orta seçenek daha geniş, yazı bir kademe küçük. -->
                <Grid TextElement.FontSize="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="OutputTv" Content="TV" GroupName="subtitleOutput" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Tv" FontSize="14" />
                    <RadioButton x:Name="OutputComputer" Grid.Column="1" Content="{t:T 'Computer screen'}" GroupName="subtitleOutput" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Computer" FontSize="14" />
                    <RadioButton x:Name="OutputBoth" Grid.Column="2" Content="{t:T 'Both'}" GroupName="subtitleOutput" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Both" FontSize="14" />
                </Grid>
            </Border>
            <StackPanel x:Name="ComputerPanel" Margin="0,12,0,0">
                <TextBlock x:Name="WindowHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="{t:T 'Subtitles appear in a window on this computer, over the game or PS Remote Play.'}" />
                <!-- Tek satır: solda "Tıklamalar geçsin", sağda pencereyi ayarlama (ikonlu, kompakt). -->
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="Adjust" DockPanel.Dock="Right" Style="{StaticResource CompactButton}" HorizontalAlignment="Right" Padding="12,0"
                            Click="OnAdjust" ToolTip="{t:T 'Adjust the subtitle window'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static c:Glyphs.Settings}" Style="{StaticResource GlyphText}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{t:T 'Adjust'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="ClickThrough" Content="{t:T 'Clicks pass through'}" Foreground="{DynamicResource textPrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnClickThrough" Unchecked="OnClickThrough" />
                </DockPanel>
                <TextBlock x:Name="ClickThroughHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,0" />
            </StackPanel>
        </StackPanel>
    </c:Card>
</UserControl>
